{
  "name": "danmaku-timeline-studio",
  "version": "0.4.1",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --config=playwright.release.config.ts",
    "lint": "eslint .",
    "audit:source": "node scripts/audit-source.mjs",
    "audit:architecture": "node --test scripts/audit-architecture.test.mjs && node scripts/audit-architecture.mjs",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "licenses:check": "node scripts/generate-license-inventory.mjs --check",
    "synthetic:run": "vite-node scripts/run-synthetic-alignment.ts",
    "verify": "corepack pnpm theme:check && corepack pnpm audit:source && corepack pnpm audit:architecture && corepack pnpm licenses:check && corepack pnpm lint && corepack pnpm test && corepack pnpm build",
    "verify:release": "corepack pnpm verify && corepack pnpm test:e2e:release && corepack pnpm tauri:build",
    "format": "prettier --write .",
    "align:audio": "node scripts/audio-align-prototype.mjs",
    "c137:authority": "node scripts/c137-authority.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-desktop-release.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check && node --test scripts/generate-theme.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.3",
    "vite-node": "3.2.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.3": "6.4.3",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=4 <5.0.9": "5.0.9",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@<2.11.0": "2.11.0"
    }
  }
}
